# App
APP_NAME=Promptflow AI Engine
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Shared local stack (keep in sync with backend/.env.example + frontend/.env.example)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5050
AI_ENGINE_URL=http://localhost:8000

# OpenAI — set your key in ai-engine/.env (never commit .env)
OPENAI_API_KEY=sk-your-openai-key
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
