# Vite — only VITE_* vars are exposed to the browser
VITE_APP_NAME=Promptflow

# Shared local stack (keep in sync with backend/.env.example + ai-engine/.env.example)
VITE_FRONTEND_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:5050
VITE_AI_ENGINE_URL=http://localhost:8000

# Leave empty to use the Vite /api proxy → backend
VITE_API_BASE_URL=
