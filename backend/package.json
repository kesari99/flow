{
  "name": "promptflow-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:all": "concurrently -n backend,frontend,ai -c blue,green,magenta \"npm run dev\" \"npm run dev --workspace=frontend\" \"cd ../ai-engine && .venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\"",
    "dev": "NODE_ENV=dev tsx src/index.ts",
    "start": "NODE_ENV=prod node dist/index.js",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "check": "tsc",
    "migrate:generate": "NODE_ENV=dev tsx scripts/generate-migrations.js",
    "migrate:push": "NODE_ENV=dev tsx scripts/migrate.js",
    "migrate:uat": "NODE_ENV=uat tsx scripts/migrate.js",
    "migrate:prod": "NODE_ENV=prod tsx scripts/migrate.js",
    "seed:admin": "NODE_ENV=dev tsx scripts/seed-admin.js"
  },
  "dependencies": {
    "@promptflow/shared": "*",
    "app-root-path": "^3.1.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "sequelize": "^6.37.7",
    "winston": "^3.17.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.3",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}
