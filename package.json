{
  "name": "promptflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev:all --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:ai": "cd ai-engine && python3 -m uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "check": "npm run check --workspace=backend",
    "migrate:generate": "npm run migrate:generate --workspace=backend",
    "migrate:push": "npm run migrate:push --workspace=backend",
    "seed:admin": "npm run seed:admin --workspace=backend"
  }
}
